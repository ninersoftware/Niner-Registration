{
    "manifest_version": 3,
    "name": "Niner Registration",
    "version": "2.0",
    "description": "An all-in-one registration tool for Charlotte students.",
    "author": "austinkmangold@gmail.com",
    "homepage_url": "https://github.com/ninersoftware/Niner-Registration",
    "permissions": ["storage", "scripting"],
    "action": {
        "default_popup": "extension/popup.html",
        "default_icon": {
            "16": "icons/logo16px.png",
            "48": "icons/logo48px.png",
            "128": "icons/logo128px.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://selfservice.uncc.edu/StudentRegistrationSsb/*"
            ],
            "js": ["extension/content.js", "extension/modal.js", "extension/grades.js", "extension/calendar.js"],
            "css": ["extension/content.css"],
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "extension/rmp.js",
        "scripts": ["extension/rmp.js"]
    },
    "host_permissions": [
        "https://www.ratemyprofessors.com/*",
        "*://selfservice.uncc.edu/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["extension/data/grades.json"],
            "matches": ["*://selfservice.uncc.edu/*"]
        }
    ],
    "icons": {
        "16": "icons/logo16px.png",
        "48": "icons/logo48px.png",
        "128": "icons/logo128px.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "contact@zagog629.8shield.net",
            "strict_min_version": "121.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}